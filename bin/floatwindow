#!/usr/bin/env python3
"""Touch move and resize controls for the focused Hyprland floating window."""
import json
import math
import os
import re
import subprocess
import sys
import time
from pathlib import Path

PRELOAD = "libgtk4-layer-shell.so.0"
preloaded = os.environ.get("LD_PRELOAD", "").split()
if PRELOAD not in preloaded:
    os.environ["LD_PRELOAD"] = " ".join([PRELOAD, *preloaded])
    os.execv(sys.executable, [sys.executable, *sys.argv])

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Pango
from gi.repository import Gtk4LayerShell as LS


FALLBACK_COLORS = """
@define-color float_surface #1f1d2e;
@define-color float_text #e0def4;
@define-color float_muted #b8b3ce;
@define-color float_tonal #362e42;
@define-color float_on_tonal #f3deec;
@define-color float_primary #c4a7e7;
@define-color float_on_primary #2d1d40;
@define-color float_shadow #100e18;
"""

PANEL_STYLE = """
window.floatwindow {
    background: transparent;
    box-shadow: none;
}
.float-panel {
    background-color: @float_surface;
    color: @float_text;
    border-radius: 24px;
    box-shadow: 0 5px 12px alpha(@float_shadow, 0.34);
    margin: 14px;
    padding: 16px;
}
.float-title { font-size: 20px; font-weight: 600; }
.float-status { color: @float_muted; font-size: 12px; }
.float-pad, button.float-step, button.float-type, button.float-done {
    background-image: none;
    box-shadow: none;
    border: 0;
    border-radius: 24px;
    font-weight: 600;
}
.float-pad, button.float-step, button.float-type {
    background-color: @float_tonal;
    color: @float_on_tonal;
}
.float-pad { padding: 0 12px; }
button.float-step { padding: 0; }
button.float-type { padding: 0 16px; }
button.float-done {
    background-color: @float_primary;
    color: @float_on_primary;
    padding: 0 18px;
}
.float-pad:hover, button.float-step:hover, button.float-type:hover {
    background-color: mix(@float_tonal, @float_on_tonal, 0.04);
}
button.float-done:hover {
    background-color: mix(@float_primary, @float_on_primary, 0.09);
}
.float-pad:active, button.float-step:active, button.float-type:active {
    background-color: @float_primary;
    color: @float_on_primary;
}
button.float-done:active {
    background-color: mix(@float_primary, @float_on_primary, 0.16);
}
button.float-step:focus-visible, button.float-type:focus-visible, button.float-done:focus-visible {
    outline: 2px solid @float_primary;
    outline-offset: 2px;
}
"""


def style_panel(window):
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    try:
        colors = (cache / "noctalia-touch" / "colors.css").read_text()
    except OSError:
        colors = FALLBACK_COLORS
    provider = Gtk.CssProvider()
    provider.load_from_string(colors + PANEL_STYLE)
    Gtk.StyleContext.add_provider_for_display(window.get_display(), provider,
                                              Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    window.add_css_class("floatwindow")


def hypr(*args):
    result = subprocess.run(["hyprctl", *args], capture_output=True, text=True,
                            check=True, timeout=0.25)
    return result.stdout.strip()


def bounds(monitor):
    width, height = monitor["width"], monitor["height"]
    if monitor["transform"] % 2:
        width, height = height, width
    left, top, right, bottom = monitor["reserved"]
    x, y = monitor["x"], monitor["y"]
    return (x + left, y + top,
            x + round(width / monitor["scale"]) - right,
            y + round(height / monitor["scale"]) - bottom)


def clamp(value, lower, upper):
    return round(max(lower, min(value, upper)))


class Controls(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.noctaliaTouch.FloatWindow")
        self.drag = None

    def do_activate(self):
        if self.get_active_window():
            self.get_active_window().close()
            return

        win = Gtk.Window(application=self, title="Floating window")
        LS.init_for_window(win)
        LS.set_namespace(win, "floatwindow")
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
        LS.set_anchor(win, LS.Edge.BOTTOM, True)
        LS.set_margin(win, LS.Edge.BOTTOM, 8)
        panel = next((m for m in win.get_display().get_monitors()
                      if m.get_connector() == "@OUTPUT@"), None)
        if panel:
            LS.set_monitor(win, panel)

        style_panel(win)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        root.add_css_class("float-panel")
        win.set_child(root)
        header = Gtk.Box(spacing=12, margin_bottom=4)
        heading = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True,
                          valign=Gtk.Align.CENTER)
        title = Gtk.Label(label="Window controls", xalign=0)
        title.add_css_class("float-title")
        self.status = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=26)
        self.status.add_css_class("float-status")
        heading.append(title)
        heading.append(self.status)
        header.append(heading)
        self.type_button = self.button("Float", self.change_type)
        self.type_button.add_css_class("float-type")
        header.append(self.type_button)
        done = self.button("Done", win.close)
        done.add_css_class("float-done")
        header.append(done)
        root.append(header)
        self.geometry_controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.geometry_controls.append(self.row("move", "Drag to move", ("←", "↑", "↓", "→")))
        self.geometry_controls.append(self.row("resize", "Drag to resize", ("↔−", "↕−", "↕+", "↔+")))
        root.append(self.geometry_controls)

        try:
            target = json.loads(hypr("-j", "activewindow"))
            self.address = target.get("address", "")
            self.show_target(target if re.fullmatch(r"0x[0-9a-fA-F]+", self.address) else {})
        except (OSError, ValueError, subprocess.SubprocessError):
            self.show_target({}, "Hyprland is unavailable")
        win.present()

    def show_target(self, target, message=None):
        adjustable = bool(target) and not target.get("fullscreen") and not target.get("hidden")
        floating = self.usable(target)
        self.type_button.set_visible(adjustable)
        self.type_button.set_label("Tile" if floating else "Float")
        self.geometry_controls.set_visible(adjustable and bool(floating))
        if message is None:
            if adjustable:
                message = target.get("title") or ("Floating window" if floating else "Tiled window")
            else:
                message = "Restore the window first" if target.get("fullscreen") else "Focus a window first"
        self.status.set_text(message)

    def client(self):
        clients = json.loads(hypr("-j", "clients"))
        return next((window for window in clients if window["address"] == self.address), {})

    def change_type(self):
        if self.drag:
            return
        try:
            target = self.client()
            if not target or target.get("fullscreen") or target.get("hidden"):
                self.show_target(target)
                return
            action = "unset" if target.get("floating") else "set"
            command = f'hl.dsp.window.float({{window="address:{self.address}", action="{action}"}})'
            if hypr("dispatch", command) != "ok":
                raise ValueError("Window type change rejected")
            updated = self.client()
            changed = updated and bool(updated.get("floating")) == (action == "set")
            self.show_target(updated, None if changed else "Could not change window type")
        except (OSError, ValueError, subprocess.SubprocessError):
            self.status.set_text("Could not change window type")

    @staticmethod
    def usable(window):
        return window.get("floating") and not window.get("fullscreen")

    @staticmethod
    def button(label, action):
        widget = Gtk.Button(label=label, height_request=48, width_request=48)
        widget.connect("clicked", lambda *_: action())
        return widget

    def row(self, mode, label, arrows):
        row = Gtk.Box(spacing=4)
        pad = Gtk.Label(label=label, width_request=96, height_request=48, hexpand=True)
        pad.add_css_class("float-pad")
        pad.set_cursor_from_name("grab")
        pad.set_tooltip_text(f"Drag here to {mode} the window")
        gesture = Gtk.GestureDrag()
        gesture.connect("drag-begin", self.begin, mode)
        gesture.connect("drag-update", self.update)
        gesture.connect("drag-end", self.update, True)
        gesture.connect("cancel", self.cancel)
        pad.add_controller(gesture)
        row.append(pad)
        steps = ((-1, 0), (0, -1), (0, 1), (1, 0))
        descriptions = (("Move left", "Move up", "Move down", "Move right")
                        if mode == "move" else
                        ("Narrower", "Shorter", "Taller", "Wider"))
        for symbol, (x, y), description in zip(arrows, steps, descriptions):
            button = self.button(symbol, lambda x=x, y=y: self.step(mode, x, y))
            button.add_css_class("float-step")
            button.set_tooltip_text(description)
            button.update_property([Gtk.AccessibleProperty.LABEL], [description])
            row.append(button)
        return row

    def snapshot(self, mode):
        client = self.client()
        monitors = json.loads(hypr("-j", "monitors"))
        monitor = next((m for m in monitors if m["id"] == client.get("monitor")), None)
        workspace = client.get("workspace", {}).get("address")
        visible_workspaces = {
            monitor[key].get("address") for key in ("activeWorkspace", "specialWorkspace")
        } if monitor else set()
        if (not self.usable(client) or monitor is None or client.get("hidden")
                or not workspace or workspace not in visible_workspaces):
            self.status.set_text("Reopen for a visible floating window")
            return None
        initial = client["at"] if mode == "move" else client["size"]
        return mode, client, monitor, initial

    def dispatch(self, mode, values):
        x, y = values
        command = f'hl.dsp.window.{mode}({{window="address:{self.address}", x={x}, y={y}, relative=false}})'
        if hypr("dispatch", command) != "ok":
            raise ValueError("Window adjustment rejected")

    def adjust(self, snapshot, dx, dy):
        mode, client, monitor, (x, y) = snapshot
        left, top, right, bottom = bounds(monitor)
        if mode == "move":
            w, h = client["size"]
            values = (clamp(x + dx, left, right - w), clamp(y + dy, top, bottom - h))
        else:
            wx, wy = client["at"]
            max_w, max_h = max(right - wx, 1), max(bottom - wy, 1)
            min_w, min_h = min(120, x, max_w), min(88, y, max_h)
            values = (clamp(x + dx, min_w, max_w), clamp(y + dy, min_h, max_h))
        self.dispatch(mode, values)

    def begin(self, gesture, _x, _y, mode):
        if self.drag:
            gesture.set_state(Gtk.EventSequenceState.DENIED)
            return
        try:
            self.drag = self.snapshot(mode)
        except (OSError, ValueError, subprocess.SubprocessError):
            self.status.set_text("Could not read window geometry")
        self.owner = gesture
        self.last_update = 0
        self.changed = False

    def update(self, gesture, dx, dy, end=False):
        if not self.drag or gesture != self.owner:
            return
        try:
            now = time.monotonic()
            if (self.changed or math.hypot(dx, dy) >= 6) and (end or now - self.last_update >= 0.032):
                self.adjust(self.drag, dx, dy)
                self.last_update = now
                self.changed = True
        except (OSError, ValueError, subprocess.SubprocessError):
            self.status.set_text("Could not adjust window")
            self.drag = None
        finally:
            if end:
                self.drag = None

    def cancel(self, gesture, _sequence):
        if self.drag and gesture == self.owner:
            snapshot, self.drag = self.drag, None
            if self.changed:
                try:
                    self.dispatch(snapshot[0], snapshot[3])
                except (OSError, ValueError, subprocess.SubprocessError):
                    self.status.set_text("Could not restore window")

    def step(self, mode, x, y):
        if self.drag:
            return
        try:
            snapshot = self.snapshot(mode)
            if snapshot:
                self.adjust(snapshot, 32 * x, 32 * y)
        except (OSError, ValueError, subprocess.SubprocessError):
            self.status.set_text("Could not adjust window")


if __name__ == "__main__":
    sys.exit(Controls().run(sys.argv))
